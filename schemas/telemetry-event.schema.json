{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CiteFrontier telemetry event",
  "type": "object",
  "required": ["event_type", "timestamp_s", "server_ms", "session_id", "event_id", "turn_id", "token_cost", "payload"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "transcript_normalized",
        "controller_decision",
        "intents_decomposed",
        "provisional_invalidated",
        "retrieval_started",
        "retrieval_finished",
        "candidate_cache_reused",
        "final_evidence_ranked",
        "retrieval_timeout",
        "stale_result_discarded",
        "claim_verified",
        "answer_version",
        "response_emitted"
      ]
    },
    "timestamp_s": {"type": "number", "minimum": 0},
    "server_ms": {"type": "number", "minimum": 0},
    "session_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "token_cost": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "estimated_usd", "basis"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_usd": {"type": "number", "minimum": 0},
        "basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
