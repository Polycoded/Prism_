{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CiteFrontier development replay case",
  "type": "object",
  "required": ["case_id", "events", "expectation"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp_s", "text", "is_final"],
        "properties": {
          "timestamp_s": {"type": "number", "minimum": 0},
          "text": {"type": "string"},
          "is_final": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "expectation": {
      "type": "object",
      "required": ["eligible_for_early_retrieval", "minimum_subintents", "allowed_citations", "no_retrieval_required"],
      "properties": {
        "eligible_for_early_retrieval": {"type": "boolean"},
        "minimum_subintents": {"type": "integer", "minimum": 1},
        "allowed_citations": {"type": "array", "items": {"type": "string"}},
        "no_retrieval_required": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
