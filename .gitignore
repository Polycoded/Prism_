# Training runs: retain only the promoted checkpoint under checkpoints/best.
# The large model.safetensors artifact (264 MB) is kept local-only and is not
# pushed; re-enable tracking via .gitattributes when it should be shared.
bert_intent_tagger/model/checkpoints/checkpoint-*/
bert_intent_tagger/model/checkpoints/best/model.safetensors
bert_intent_tagger/model/checkpoints/best/training_args.bin
bert_intent_tagger/model/checkpoints/best/trainer_state.json
bert_intent_tagger/model/checkpoints/best/optimizer.pt
bert_intent_tagger/model/checkpoints/best/scheduler.pt
